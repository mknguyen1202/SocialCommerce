{
    "Logging": {
        "LogLevel": {
            "Default": "Debug",
            "Microsoft.AspNetCore": "Information"
        }
    },

    "ConnectionStrings": {
        "Default": "Host=localhost;Port=5432;Database=auth_dev;Username=postgres;Password=postgres;Ssl Mode=Disable",
        "Redis": "localhost:6379"

    },

    "Cors": {
        "AllowedOrigins": [ "https://localhost:5173", "http://localhost:3000" ]
    },

    "DataProtection": {
        "KeysDirectory": "" // in-memory keys ok for dev; leave blank
    },

    "Sessions": {
        "UseEfCoreStore": false // dev: use in-memory sessions
    },

    "SessionCookie": {
        "SameSite": "None",
        "SecurePolicy": "Always" // cookie only sent over HTTPS (required for SameSite=None)
    },
    "Security": {
        "Csrf": {
            "SameSite": "None" // because SPA is on a different origin in dev
        }
    },

    "Auth": {
        "Google": {
            "RedirectUri": "https://localhost:32770/auth/google/callback",
            "Scopes": [ "openid", "email", "profile" ],
            "AuthorizeEndpoint": "https://accounts.google.com/o/oauth2/v2/auth",
            "TokenEndpoint": "https://oauth2.googleapis.com/token",
            "JwksUri": "https://www.googleapis.com/oauth2/v3/certs"
        },
        "Microsoft": {
            "RedirectUri": "http://localhost:5280/auth/microsoft/callback"
        },
        "Facebook": {
            "RedirectUri": "http://localhost:5280/auth/facebook/callback"
        },
        "Apple": {
            "RedirectUri": "http://localhost:5280/auth/apple/callback"
        }
    },

    "BffProxy": {
        "Routes": [
            {
                "PathPrefix": "/api/user/",
                "Destination": "http://localhost:7001/",
                "AttachInternalJwt": true,
                "AllowAnonymous": false
            },
            {
                "PathPrefix": "/api/social/",
                "Destination": "http://localhost:7002/",
                "AttachInternalJwt": true,
                "AllowAnonymous": false
            },
            {
                "PathPrefix": "/api/public/",
                "Destination": "http://localhost:7003/",
                "AttachInternalJwt": false,
                "AllowAnonymous": true
            }
        ]
    },

    "InternalJwt": {
        "Issuer": "authorization-service-dev",
        "Audience": "socialcommerce-internal",
        "LifetimeSeconds": 180,
        "SymmetricKey": "dev-secret-must-be-at-least-32-bytes-long!!!!"
    }
}
