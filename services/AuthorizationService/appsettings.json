{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",

    "ConnectionStrings": {
        "Default": "Host=postgres;Port=5432;Database=auth;Username=postgres;Password=${POSTGRES_PASSWORD};Ssl Mode=Disable"
    },

    "Cors": {
        "AllowedOrigins": [ "https://app.yourdomain.com", "https://admin.yourdomain.com" ]
    },

    "DataProtection": {
        "KeysDirectory": "/var/keys/dataprotection" // mount a persistent volume in prod
    },

    "Sessions": {
        "UseEfCoreStore": true
    },

    "SessionCookie": {
        "Name": "bff.session",
        "UseHostPrefix": true,
        "HttpOnly": true,
        "SecurePolicy": "Always",
        "SameSite": "Lax",
        "Path": "/",
        "IdleTimeoutMinutes": 45,
        "AbsoluteLifetimeDays": 14,
        "PersistentCookie": false
    },

    "Security": {
        "StateTtlMinutes": 10,
        "NonceTtlMinutes": 10,
        "Csrf": {
            "Mode": "DoubleSubmit",
            "CookieName": "XSRF-TOKEN",
            "HeaderName": "X-CSRF-Token",
            "TokenTtlMinutes": 30,
            "SameSite": "Lax",
            "Secure": true,
            "Path": "/"
        }
    },

    "Auth": {
        "ReturnUrl": {
            "DefaultPath": "/",
            "AllowedPathPrefixes": [ "/", "/dashboard", "/account", "/shop" ],
            "AllowExternal": false,
            "AllowedOrigins": [],
            "BasePath": "/"
        },

        "Google": {
            "ClientId": "${GOOGLE_CLIENT_ID}",
            "ClientSecret": "${GOOGLE_CLIENT_SECRET}",
            "RedirectUri": "https://auth.yourdomain.com/auth/google/callback",
            "Scopes": [ "openid", "email", "profile" ],
            "AccessType": "offline",
            "Prompt": "consent",
            "ResponseMode": "query",
            "AuthorizeEndpoint": "https://accounts.google.com/o/oauth2/v2/auth",
            "TokenEndpoint": "https://oauth2.googleapis.com/token",
            "JwksUri": "https://www.googleapis.com/oauth2/v3/certs",
            "Authority": "https://accounts.google.com"
        },

        "Microsoft": {
            "ClientId": "${MS_CLIENT_ID}",
            "ClientSecret": "${MS_CLIENT_SECRET}",
            "RedirectUri": "https://auth.yourdomain.com/auth/microsoft/callback",
            "Scopes": [ "openid", "email", "profile" ],
            "ResponseMode": "query",
            "AuthorizeEndpoint": "https://login.microsoftonline.com/common/oauth2/v2.0/authorize",
            "TokenEndpoint": "https://login.microsoftonline.com/common/oauth2/v2.0/token",
            "JwksUri": "https://login.microsoftonline.com/common/discovery/v2.0/keys",
            "Authority": "https://login.microsoftonline.com/common/v2.0"
        },

        "Facebook": {
            "ClientId": "${FB_APP_ID}",
            "ClientSecret": "${FB_APP_SECRET}",
            "RedirectUri": "https://auth.yourdomain.com/auth/facebook/callback",
            "Scopes": [ "public_profile", "email" ],
            "AuthorizeEndpoint": "https://www.facebook.com/v20.0/dialog/oauth",
            "TokenEndpoint": "https://graph.facebook.com/v20.0/oauth/access_token"
        },

        "Apple": {
            "ClientId": "${APPLE_SERVICE_ID}",
            "TeamId": "${APPLE_TEAM_ID}",
            "KeyId": "${APPLE_KEY_ID}",
            "P8PrivateKeyPem": "${APPLE_P8_PRIVATE_KEY_PEM}", // store in secret manager / env
            "ClientSecretLifetimeMinutes": 15,
            "RedirectUri": "https://auth.yourdomain.com/auth/apple/callback",
            "Scopes": [ "name", "email" ],
            "ResponseMode": "form_post",
            "AuthorizeEndpoint": "https://appleid.apple.com/auth/authorize",
            "TokenEndpoint": "https://appleid.apple.com/auth/token",
            "JwksUri": "https://appleid.apple.com/auth/keys",
            "Authority": "https://appleid.apple.com"
        }
    },

    "BffProxy": {
        "Routes": [
            {
                "PathPrefix": "/api/user/",
                "Destination": "http://userservice:8080/",
                "AttachInternalJwt": true,
                "AllowAnonymous": false,
                "TimeoutSeconds": 15
            },
            {
                "PathPrefix": "/api/social/",
                "Destination": "http://socialsvc:8080/",
                "AttachInternalJwt": true,
                "AllowAnonymous": false,
                "TimeoutSeconds": 15
            },
            {
                "PathPrefix": "/api/public/",
                "Destination": "http://publicsvc:8080/",
                "AttachInternalJwt": false,
                "AllowAnonymous": true,
                "TimeoutSeconds": 10
            }
        ]
    },

    "InternalJwt": {
        "Issuer": "authorization-service",
        "Audience": "socialcommerce-internal",
        "LifetimeSeconds": 180,
        "RsaPrivateKeyPem": "${INTERNAL_JWT_RSA_PRIVATE_PEM}"
        // For dev only you can use: "SymmetricKey": "${INTERNAL_JWT_HS256_KEY}"
    }
}
