{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "Default": "Host=localhost;Port=5432;Database=user_db;Username=postgres;Password=1234;Ssl Mode=Disable"
    },
    "Authentication": {
        "Jwt": {
            "Issuer": "SocialCommerce",
            "Audience": "sc-rt-hub",
            "SymmetricKey": "",
            "AccessTokenMinutes": 5,
            "ClockSkewSeconds": 30
        }
    },
    "MediaService": {
        "BaseUrl": "http://localhost:5006"
    },
    "Cors": {
        "Origins": "https://localhost:5173"
    },
    "ReverseProxy": {
        "Routes": {
            "posts": {
                "ClusterId": "socialcontent",
                "Match": { "Path": "/api/posts/{**catch-all}" }
            },
            "posts-root": {
                "ClusterId": "socialcontent",
                "Match": { "Path": "/api/posts" }
            },
            "groups": {
                "ClusterId": "socialcontent",
                "Match": { "Path": "/api/groups/{**catch-all}" }
            },
            "groups-root": {
                "ClusterId": "socialcontent",
                "Match": { "Path": "/api/groups" }
            },
            "comments": {
                "ClusterId": "socialcontent",
                "Match": { "Path": "/api/comments/{**catch-all}" }
            },
            "polls": {
                "ClusterId": "socialcontent",
                "Match": { "Path": "/api/polls/{**catch-all}" }
            },
            "user-posts": {
                "ClusterId": "socialcontent",
                "Match": { "Path": "/api/content/users/{**catch-all}" }
            },
            "feed": {
                "ClusterId": "feed",
                "Match": { "Path": "/api/feed/{**catch-all}" }
            },
            "feed-root": {
                "ClusterId": "feed",
                "Match": { "Path": "/api/feed" }
            },
            "conversations": {
                "ClusterId": "communication",
                "Match": { "Path": "/conversations/{**catch-all}" }
            },
            "conversations-root": {
                "ClusterId": "communication",
                "Match": { "Path": "/conversations" }
            }
        },
        "Clusters": {
            "socialcontent": {
                "Destinations": {
                    "default": { "Address": "http://localhost:5003" }
                }
            },
            "feed": {
                "Destinations": {
                    "default": { "Address": "http://localhost:5004" }
                }
            },
            "communication": {
                "Destinations": {
                    "default": { "Address": "http://localhost:5008" }
                }
            }
        }
    }
}
