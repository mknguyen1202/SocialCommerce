{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "ConnectionStrings": {
        "Default": "Host=localhost;Port=5432;Database=feed;Username=postgres;Password=1234;Ssl Mode=Disable"
    },
    "Redis": {
        "Connection": "localhost:6379,abortConnect=false"
    },
    "ServiceBus": {
        "Connection": "", // optional in dev
        "Topic": "social-events",
        "Subscription": "feed"
    },
    "GraphService": {
        "BaseUrl": "https://localhost:5005", // your SocialGraphService base URL
        "TimeoutSeconds": 4
    },
    "Swagger": { "Enabled": true },
    "Authentication": {
        "Jwt": {
            "SymmetricKey": "",
            "Issuer": "SocialCommerce"
        }
    },
    "AllowedHosts": "*"
}
